# Required application session-signing secret (generate a long random value)
APP_SIGNING_SECRET=replace_with_a_random_secret

# IANA time zone used for appointment entry and display (for example Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Missed appointment grace period after its scheduled end
APPOINTMENT_GRACE_MINUTES=15

# Background appointment check interval
APPOINTMENT_CHECK_INTERVAL_SECONDS=60

# Default appointment duration; missed detection waits until end plus grace period
APPOINTMENT_DURATION_MINUTES=30

# Referral alert when no hospital attendance is recorded within this many clinic-calendar days
REFERRAL_ATTENDANCE_FOLLOW_UP_DAYS=5

# Confidential original screening images and PDFs (keep outside public/static frontend folders)
GLUCOVISION_PRIVATE_STORAGE_DIR=./private_storage
